{
  "version": "1.1",
  "source": "synthetic independent requirements; fixture assistant acknowledgements; semantic routing only",
  "cases": [
    {
      "id": "duration_correction",
      "replaced_minutes": {"40": 30},
      "split": "development",
      "turns": [
        "给我训练安排建议，每次最多40分钟，周三不能练，只看建议不要保存。",
        "时间改为最多30分钟，其余要求保持。"
      ],
      "gap": true,
      "must_match": [
        "30\\s*分钟",
        "周三",
        "不能|不安排|不.*训练",
        "建议",
        "不.*(?:保存|写入|持久化)"
      ],
      "must_not_match": [
        "40分钟"
      ],
      "semantic_fields": {
        "requested_effect": "read"
      }
    },
