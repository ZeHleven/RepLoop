{
  "fixture_version": "1.0.0",
  "endpoint_contract": {
    "read": {
      "method": "GET",
      "path": "/api/v1/agent/proposals/{proposal_id}",
      "auth_source": "jwt_current_user",
      "request_body_keys": [],
      "success_status": 200,
      "response_keys": [
        "id",
        "proposal_type",
        "status",
        "version",
        "payload_fingerprint",
        "payload",
        "expires_at",
        "created_at",
        "updated_at",
        "allowed_actions",
        "result"
      ],
      "payload_keys": [
        "schema_version",
        "proposal_type",
        "target",
        "before",
        "after",
        "changes",
        "evidence",
        "rationale",
        "safety_notes"
      ]
    },
    "confirm": {
      "method": "POST",
      "path": "/api/v1/agent/proposals/{proposal_id}/confirm",
      "auth_source": "jwt_current_user",
      "success_status": 200
    },
    "reject": {
      "method": "POST",
      "path": "/api/v1/agent/proposals/{proposal_id}/reject",
      "auth_source": "jwt_current_user",
      "success_status": 200
    },
    "decision_request": {
      "keys": [
        "expected_version",
        "client_request_id"
      ],
      "expected_version": {
        "type": "strict_integer",
        "minimum": 1
      },
      "client_request_id": {
        "type": "strict_string",
        "minimum_length": 8,
        "maximum_length": 120
      },
      "unknown_fields": "forbidden",
      "user_id_source": "jwt_only"
    },
    "decision_response": {
      "keys": [
        "id",
        "proposal_type",
        "status",
        "version",
        "applied",
        "payload_fingerprint",
        "result_plan_id",
        "result_plan_fingerprint",
        "decided_at"
      ],
      "same_request_replay": "exact_same_body",
      "different_confirm_after_applied": "same_applied_result"
    },
    "business_error": {
      "body_keys": [
        "code",
        "message"
      ],
      "status_by_code": {
        "proposal_not_found": 404,
        "proposal_not_pending": 409,
        "proposal_version_conflict": 409,
        "proposal_expired": 409,
        "proposal_feature_disabled": 503
      },
      "validation_status": 422
    },
    "privacy": {
      "forbidden_response_keys": [
        "user_id",
        "conversation_id",
        "run_id",
        "decision_client_request_id",
        "raw_prompt",
        "raw_observation",
        "model_output",
        "jwt"
      ]
    }
  },
  "read_cases": [
    {
      "case_id": "read.owned_pending_returns_full_confirmable_view",
      "owner_state": "owned",
      "stored_status": "pending_confirmation",
      "time_state": "before_expiry",
      "expected": {
        "http_status": 200,
        "error_code": null,
        "effective_status": "pending_confirmation",
        "allowed_actions": [
          "confirm",
          "reject"
        ],
        "result_present": false,
        "durable_write_count": 0
      }
    },
    {
      "case_id": "read.owned_pending_at_expiry_projects_expired_without_write",
      "owner_state": "owned",
      "stored_status": "pending_confirmation",
      "time_state": "at_or_after_expiry",
      "expected": {
        "http_status": 200,
        "error_code": null,
        "effective_status": "expired",
        "allowed_actions": [],
        "result_present": false,
        "durable_write_count": 0
      }
    },
    {
      "case_id": "read.owned_applied_returns_result_without_actions",
      "owner_state": "owned",
      "stored_status": "applied",
      "time_state": "before_expiry",
      "expected": {
        "http_status": 200,
        "error_code": null,
        "effective_status": "applied",
        "allowed_actions": [],
        "result_present": true,
        "durable_write_count": 0
      }
    },
    {
      "case_id": "read.owned_rejected_returns_terminal_view",
      "owner_state": "owned",
      "stored_status": "rejected",
      "time_state": "before_expiry",
      "expected": {
        "http_status": 200,
        "error_code": null,
        "effective_status": "rejected",
        "allowed_actions": [],
        "result_present": false,
        "durable_write_count": 0
      }
    },
    {
      "case_id": "read.foreign_owner_is_indistinguishable_from_missing",
      "owner_state": "foreign",
      "stored_status": "pending_confirmation",
      "time_state": "before_expiry",
      "expected": {
        "http_status": 404,
        "error_code": "proposal_not_found",
        "effective_status": null,
        "allowed_actions": [],
        "result_present": false,
        "durable_write_count": 0
      }
    },
    {
      "case_id": "read.missing_returns_same_not_found_contract",
      "owner_state": "missing",
      "stored_status": null,
      "time_state": "before_expiry",
      "expected": {
        "http_status": 404,
        "error_code": "proposal_not_found",
        "effective_status": null,
        "allowed_actions": [],
        "result_present": false,
        "durable_write_count": 0
      }
    }
  ],
  "request_validation_cases": [
    {
      "case_id": "request.expected_version_zero_is_rejected",
      "body": {
        "expected_version": 0,
        "client_request_id": "decision-version-zero"
