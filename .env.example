DATABASE_URL=postgresql+asyncpg://fitness:fitness_pass@postgres:5432/fitness_db
REDIS_URL=redis://redis:6379
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# 微信小程序登录。AppSecret 只能配置在后端，不能写入 miniapp。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_TIMEOUT_SECONDS=5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
AGENT_ENABLED=true
AGENT_MODEL=deepseek-v4-flash
AGENT_TIMEOUT_SECONDS=60
AGENT_INTENT_MODEL_ENABLED=true
AGENT_INTENT_MODEL=deepseek-v4-flash
AGENT_RULES_FIRST_ENABLED=false
AGENT_INTENT_TIMEOUT_SECONDS=10
AGENT_INTENT_TOTAL_TIMEOUT_SECONDS=24
AGENT_INTENT_RETRY_MIN_REMAINING_SECONDS=2
AGENT_INTENT_MAX_TOKENS=1100
AGENT_INTENT_ROUTE_TIMEOUT_SECONDS=14
AGENT_INTENT_ROUTE_MAX_TOKENS=1000
DAILY_MEAL_OPTIMIZER_TIMEOUT_SECONDS=3
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_RECURSION_LIMIT=8
AGENT_PLANNED_EXECUTION_ENABLED=true
AGENT_PLANNER_TIMEOUT_SECONDS=15
AGENT_REPLANNER_TIMEOUT_SECONDS=30
AGENT_PLANNING_MAX_TOKENS=1200
AGENT_EXECUTOR_TIMEOUT_SECONDS=20
AGENT_MAX_PLAN_STEPS=3
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_REPLANS=1
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_STEP_DECISIONS=4
AGENT_DIRECT_STEP_MAX_TOOL_CALLS=1
AGENT_REACT_STEP_MAX_TOOL_CALLS=2
AGENT_ASYNC_WORKER_ENABLED=true
AGENT_WORKER_POLL_SECONDS=0.5
AGENT_RUN_LEASE_SECONDS=180
AGENT_RUN_MAX_ATTEMPTS=3
AGENT_TOOL_REGISTRY_SHADOW_ENABLED=false
AGENT_TOOL_REGISTRY_SHADOW_SAMPLE_RATE=0.0
AGENT_TOOL_REGISTRY_SHADOW_PERSIST_TRACE=false
AGENT_TOOL_REGISTRY_SHADOW_EMIT_METRICS=false
# 读取工具注册表权限切换开关；灰度验证后再开启。
AGENT_TOOL_REGISTRY_ENFORCE_READS_ENABLED=false
# 各写入提案能力独立灰度，默认关闭。
AGENT_PLAN_ADJUSTMENT_PROPOSALS_ENABLED=false
MANUAL_PLAN_PROPOSALS_ENABLED=false
AGENT_PLAN_MANAGEMENT_PROPOSALS_ENABLED=false
AGENT_PROFILE_PROPOSALS_ENABLED=false
AGENT_WEIGHT_PROPOSALS_ENABLED=false
AGENT_NUTRITION_PROPOSALS_ENABLED=false

# 云托管首次部署含新迁移时设为 true；迁移完成后的下一版本改为 false。
RUN_DB_MIGRATIONS_ON_STARTUP=true

# RAG is optional. Configure an OpenAI-compatible embeddings endpoint before enabling.
RAG_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=2048

POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness_pass
POSTGRES_DB=fitness_db
